# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------------------
# Google Cloud
# ---------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Routes the GenAI SDK at Vertex AI rather than the public Gemini API.
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Cloud Storage bucket used to stage the Agent Runtime deployment.
# Name only, no gs:// prefix.
STAGING_BUCKET=your-project-id-fluffy-memory-staging

# Written to the trigger function environment by deploy_trigger.py.
# For local bridge testing, copy resource_name from .deployed_agent.json.
AGENT_ENGINE_RESOURCE_NAME=

# ---------------------------------------------------------------------------
# ARMCL memory backend
# ---------------------------------------------------------------------------
# memory_bank -> Vertex AI Memory Bank (default, required for the Fortified track)
# chroma      -> local embedded Chroma, offline fallback only
# memory      -> in-process, tests only
ARMCL_MEMORY_BACKEND=memory_bank

# Populated by deploy.py. Leave blank to let Agent Runtime provision one.
ARMCL_MEMORY_BANK_ID=

# Local Chroma persistence directory, used only when backend=chroma.
ARMCL_CHROMA_DIR=./chroma_data

# ---------------------------------------------------------------------------
# ARMCL tuning
# ---------------------------------------------------------------------------
# Recent events handed to Tier 3 on each reconcile pass.
ARMCL_RECONCILE_WINDOW=5
# Max characters of raw tool output retained before distillation replaces it.
ARMCL_RAW_OUTPUT_BUDGET=2000
ARMCL_SYNC_RAW_SESSION_EVENTS=false
# Consecutive critic rejections before the circuit breaker halts the workflow.
ARMCL_CIRCUIT_BREAKER_THRESHOLD=3
ARMCL_SESSION_BACKEND=database
ARMCL_SESSION_DB_URL=sqlite+aiosqlite:///./armcl_sessions.db

# Screened intake documents, grant scorecards, and opportunity pipeline state
# default to process-local stores. Set these to sqlite for restart-safe local
# operation.
INTAKE_BACKEND=memory
INTAKE_DB_URL=sqlite+aiosqlite:///./armcl_intake.db
SCORECARD_BACKEND=memory
SCORECARD_DB_URL=sqlite+aiosqlite:///./armcl_intake.db
OPPORTUNITY_BACKEND=memory
OPPORTUNITY_DB_URL=sqlite+aiosqlite:///./armcl_intake.db

# ---------------------------------------------------------------------------
# Self-evolution
# ---------------------------------------------------------------------------
# After each finished run the evolver proposes a tactical playbook rewrite.
# A deterministic auditor installs it only if it does not game the proxy
# score or touch the frozen constitution. false skips the extra model call.
ARMCL_EVOLVE=true
ARMCL_BEHAVIORAL_AUDIT=true
# Optional path to persist the playbook across local invocations.
# Default: ${ARMCL_CHROMA_DIR}/playbook.json
ARMCL_PLAYBOOK_PATH=

# ---------------------------------------------------------------------------
# Guardrails (Model Armor)
# ---------------------------------------------------------------------------
# regex -> offline heuristic fallback, clearly not Model Armor
MODEL_ARMOR_TEMPLATE_ID=fluffy-memory-fleet-filter
MODEL_ARMOR_LOCATION=us-central1
GUARDRAIL_BACKEND=model_armor

# ---------------------------------------------------------------------------
# Trigger
# ---------------------------------------------------------------------------
PUBSUB_TOPIC=fluffy-memory-triggers
PUBSUB_SUBSCRIPTION=fluffy-memory-triggers-push

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=EVENT_ONLY

# Local span export when not running on Agent Runtime: console | cloud | none
ARMCL_TRACE_EXPORT=none

# ---------------------------------------------------------------------------
# Optional enhancements (off by default, degrade silently)
# ---------------------------------------------------------------------------
# Gemma-assisted salience triage: catches constraints written as prose under
# an unremarkable key, which the deterministic heuristic misses.
ARMCL_GEMMA_TRIAGE=false

# Veo-generated incident briefings for terminal states. Slow and paid.
ARMCL_VEO_BRIEFING=false
